                "사도": 1
              },
              "hp_pct": 30,
              "qi_pct": 30
            }
          }
        ]
      }
    ]
  },
  "폭포수련": {
    "chapters": [
      2,
      3,
      4
    ],
    "title": "천 길 폭포",
    "text": "천 길 폭포 아래 평평한 바위가 있다. 많은 고수가 저기서 깨달음을 얻었다고 한다. 저기서 죽은 이는 더 많다.",
    "choices": [
      {
        "label": "바위에 올라 물줄기를 받는다",
        "requires": {
          "stat_min": {
            "external": 40
          }
        },
        "outcomes": [
          {
            "text": "물줄기가 산처럼 내리눌렀다. 버티고 나니 몸의 쓸모없는 힘이 씻겨 나갔다.",
            "effects": {
              "stats": {
                "external": 4,
                "mind": 2
