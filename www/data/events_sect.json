{
  "소림_입문": {
    "chapters": [
      1,
      2
    ],
    "requires": {
      "no_sect": true,
      "max_alignment": {
        "마도": 100
      }
    },
    "title": "숭산 소실봉",
    "text": "숭산 자락에서 물지게를 진 사미승이 말을 건다. \"시주, 근골이 좋으시오. 삼 년 물을 지면 나한당 문턱은 넘을 것이오.\" 뒤편 탑림에서 목탁 소리가 끊이지 않는다.",
    "choices": [
      {
        "label": "머리를 깎고 속가제자가 된다",
        "outcomes": [
          {
            "text": "방장이 말없이 염주 한 알을 내렸다. 그날부터 물지게가 내 스승이 되었다.",
            "effects": {
              "join_sect": "소림",
              "skill": "나한권",
              "alignment": {
                "정도": 40
              },
              "stats": {
                "external": 2
              }
            }
          }
        ]
      },
      {
        "label": "합장만 하고 길을 떠난다",
        "outcomes": [
          {
            "text": "사미승이 아쉬운 듯 웃었다. \"인연이 닿으면 또 뵙겠지요.\"",
            "effects": {
              "stats": {
                "mind": 1
              }
            }
          }
        ]
      }
    ]
  },
  "소림_동인진": {
