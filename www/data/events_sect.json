    "title": "십팔동인",
    "text": "소림의 속가제자가 하산하려면 십팔동인진을 넘어야 한다. 구리 칠을 한 무승들이 어둠 속에 줄지어 선다. \"아미타불. 사정은 두지 않소.\"",
    "choices": [
      {
        "label": "동인진에 들어선다",
        "outcomes": [
          {
            "text": "진을 깨고 나오니 방장이 처음으로 눈을 떴다.",
            "effects": {
              "flags": [
                "소림_동인"
              ],
              "fame": 4,
              "battle": "십팔동인",
              "alignment": {
                "정도": 20
              }
            }
          }
        ]
      },
      {
        "label": "아직은 이르다",
        "outcomes": [
          {
            "text": "물지게를 더 지기로 했다.",
            "effects": {
              "stats": {
                "external": 2
              }
            }
          }
        ]
      }
    ]
  },
