  "무당_입문": {
    "chapters": [
      1,
      2
    ],
    "requires": {
      "no_sect": true,
      "max_alignment": {
        "마도": 100
      }
    },
    "title": "무당산의 안개",
    "text": "안개 낀 돌계단 끝, 늙은 도사가 빗자루질을 멈추고 묻는다. \"강함이란 무엇이냐?\" 대답을 기다리는 눈치도 아니다.",
    "choices": [
      {
        "label": "\"물처럼 지지 않는 것입니다\"",
        "outcomes": [
          {
            "text": "도사가 빗자루를 건넸다. 태극의 첫 구결은 비질에 있었다.",
            "effects": {
              "join_sect": "무당",
              "skill": "태극검",
              "alignment": {
                "정도": 40
              },
              "stats": {
                "mind": 2
              }
            }
          }
        ]
      },
      {
        "label": "\"이기는 것입니다\"",
        "outcomes": [
          {
            "text": "\"그래, 그럼 이기고 오너라.\" 도사는 다시 비질을 시작했다.",
            "effects": {
              "stats": {
                "martial": 2
              }
            }
          }
        ]
      }
    ]
  },
  "무당_논검": {
    "chapters": [
      2,
      3,
      4
    ],
    "requires": {
      "sect": "무당"
    },
    "title": "자소궁 논검",
    "text": "자소궁에서 논검회가 열렸다. 사형 진인이 검 대신 나뭇가지를 들고 앞에 선다. \"칼을 먼저 뽑는 자가 진다. 알겠느냐?\"",
    "choices": [
      {
        "label": "기다렸다가 흘려보낸다",
        "outcomes": [
          {
            "text": "아흔아홉 수를 흘린 뒤 마지막 한 수를 짚었다. 진인이 껄껄 웃었다.",
            "effects": {
              "flags": [
                "무당_논검"
              ],
              "fame": 4,
              "battle": "무당진인"
            }
          }
        ]
      },
      {
        "label": "경전을 더 읽겠다고 한다",
        "outcomes": [
          {
            "text": "도덕경 첫 장을 사흘 읽었다.",
            "effects": {
              "stats": {
                "mind": 3
              }
            }
          }
        ]
      }
    ]
  },
  "무당_비전": {
    "chapters": [
      3,
      4,
      5
    ],
    "requires": {
      "sect": "무당",
      "flag": "무당_논검"
    },
    "title": "금정의 새벽",
    "text": "금정에 해가 오를 때 장문인이 두 권의 책을 내민다. \"태극은 둘이되 하나다. 그러나 지금 네 그릇엔 하나뿐이구나.\"",
    "choices": [
      {
        "label": "태극심공을 받는다",
        "outcomes": [
          {
            "text": "숨 한 번에 천지가 돌았다.",
            "effects": {
              "skill": "태극심공",
              "stats": {
                "internal": 3
              }
            }
          }
        ]
      },
      {
        "label": "제운종을 받는다",
        "outcomes": [
          {
            "text": "돌계단을 밟지 않고 산을 내려왔다.",
            "effects": {
              "skill": "제운종",
              "fame": 2
            }
          }
        ]
      }
    ]
  },
  "화산_입문": {
    "chapters": [
      1,
      2
