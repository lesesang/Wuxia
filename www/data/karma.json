    "숨겨진유적": {
      "name": "폭우 뒤의 석문",
      "cost": 12,
      "desc": "폭우 뒤 드러난 옛 석문에서 시작하는 두 편의 이야기. 끝까지 가면 주무공 계열의 신공을 얻을 수 있다."
    },
    "협객의묘": {
      "name": "협객의 묘",
      "cost": 12,
      "desc": "이름 없는 협객의 무덤과 그가 남긴 부탁. 천마를 약하게 만들고 심법 신공 혼원일기공을 얻을 수 있다."
    },
    "권마의시험": {
      "name": "권마의 시험",
      "cost": 8,
      "desc": "권마의 그림자가 계곡에서 내는 시험. 세 번을 받아 내면 비록에 없는 주먹이 몸에 남는다.",
      "origin": "권마계승"
    },
    "천마의유산": {
      "name": "천마의 옛 비동",
      "cost": 12,
      "desc": "백 년 전 천마의 비동. 약점을 찾을 수도, 그 힘에 물들 수도 있다."
    },
    "생사의문": {
      "name": "생사의 문",
      "cost": 18,
      "desc": "마지막 해에 화경 이상의 무인에게만 열리는 시험. 문지기를 넘으면 보법 신공 이형환위를 얻고 크게 성장한다."
    },
    "사부의유산": {
      "name": "사부의 마지막 가르침",
      "desc": "사부의 서신과 옛 벗을 만나는 세 편의 이야기. 심법, 보법, 주무공 계열의 신공을 얻을 수 있다.",
      "cost": 12,
      "origin": "무림초출"
    },
    "창궁고검": {
