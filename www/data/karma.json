    },
    "천마의유산": {
      "name": "백 년 전의 비동",
      "cost": 12,
      "desc": "백 년 전 천마의 비동. 약점을 찾을 수도, 그 힘에 물들 수도 있다."
    },
    "생사의문": {
      "name": "생사의 문",
      "cost": 15,
      "desc": "마지막 해에 화경 이상의 무인에게만 열리는 시험. 문지기를 넘으면 보법 신공 이형환위를 얻고 크게 성장한다."
    },
    "사부의유산": {
      "name": "사부의 마지막 가르침",
      "desc": "사부의 서신과 옛 벗을 만나는 세 편의 이야기. 심법, 보법, 주무공 계열의 신공을 얻을 수 있다.",
