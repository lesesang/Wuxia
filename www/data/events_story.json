      {
        "label": "소문으로 무너진 값은 소문으로 번다",
        "outcomes": [
          {
            "text": "비도 세 자루와 명부를 챙겼다.",
            "effects": {
              "alignment": {
                "사도": 1
              },
              "silver": 15,
              "flags": [
                "하오문연줄"
              ]
